APP_NAME="All in One Place"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Conexion de la aplicacion: sin privilegios de esquema, sujeta a RLS (SEG-38)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=aiop
DB_USERNAME=aiop_app
DB_PASSWORD=

# Conexion de migraciones: dueña del esquema, no la usa la aplicacion en runtime
DB_MIGRATOR_DATABASE=aiop
DB_MIGRATOR_USERNAME=aiop_migrator
DB_MIGRATOR_PASSWORD=

DB_CONSOLA_USERNAME=aiop_consola
DB_CONSOLA_PASSWORD=

DB_TEST_DATABASE=aiop_test

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SAME_SITE=lax

# Dos SPA, dos origenes (ARQ-02)
URL_APP_EMPRESA=http://localhost:5173
URL_CONSOLA=http://localhost:5174
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@allinoneplace.test"
MAIL_FROM_NAME="${APP_NAME}"
